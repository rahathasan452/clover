{
  "name": "clover-pdf-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "python tools/run_studio.py",
    "studio:api": "python tools/studio_server.py",
    "cloud:build": "python tools/cloud_pipeline.py --build-all",
    "cloud:inbox": "python tools/cloud_pipeline.py --process-inbox",
    "vectorize": "python tools/ingest.py --backfill-vectors",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/hub": "^2.17.10",
    "@huggingface/transformers": "^4.3.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.475.0",
    "minisearch": "^7.1.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
